node_modules/
dist/
build/
coverage/
*.tsbuildinfo

# Runtime data — never commit job files or the database
data/
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm

# Vendored binary assets are fetched by infra/bundle/fetch-assets.sh
# and verified against assets/vendor/MANIFEST.md. Never committed.
assets/vendor/**
!assets/vendor/MANIFEST.md
!assets/vendor/.gitkeep
# The directory itself is kept so the image build can copy it whether or not
# fetch-assets.sh has run; the faces inside are still fetched, never committed.
!assets/vendor/fonts/
!assets/vendor/fonts/.gitkeep

# Offline bundle output
infra/bundle/out/

.env
.env.local
.DS_Store
test-results/
playwright-report/

# Browser libraries copied out of node_modules at build time.
apps/api/public/vendor/

# Brand assets derived from assets/brand/ at build time.
apps/api/public/brand/

# Local Python virtualenv for the inference sidecar. The service is built from
# services/inference/requirements.txt; the environment itself is not source.
.venv-inference/
.venv/

# Editor and assistant configuration is ignored locally, in .git/info/exclude,
# so this file stays about the project rather than about anyone's tooling.
