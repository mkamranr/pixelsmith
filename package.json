{
  "name": "pixelsmith",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted, air-gapped image toolkit",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "workers/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --pretty",
    "lint": "eslint .",
    "dev:api": "npm run dev -w @pixelsmith/api",
    "dev:web": "npm run dev -w @pixelsmith/web",
    "dev:worker": "npm run dev -w @pixelsmith/worker-image",
    "db:generate": "drizzle-kit generate --config packages/db/drizzle.config.ts",
    "db:migrate": "node --experimental-strip-types packages/db/src/migrate.ts"
  },
  "devDependencies": {
    "@types/node": "22.15.30",
    "drizzle-orm": "0.45.2",
    "playwright": "1.53.0",
    "tsx": "4.20.3",
    "typescript": "5.8.3",
    "vitest": "3.2.3"
  }
}
