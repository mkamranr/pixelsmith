{# Inline SVG icons, drawn as a single stroke set so every tool card reads as
   part of one family. Inline rather than a sprite file or an icon font: no
   extra request, no external dependency, and it inherits currentColor. #}
{% macro icon(name, size = 22) %}
<svg class="icon" viewBox="0 0 24 24" width="{{ size }}" height="{{ size }}" fill="none"
     stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"
     aria-hidden="true" focusable="false">
{%- if name == 'archive' -%}
  <path d="M3 7h18v3H3z"/><path d="M5 10v10h14V10"/><path d="M10 14h4"/>
{%- elif name == 'scaling' -%}
  <path d="M3 3h8v8H3z"/><path d="M14 14h7v7h-7z"/><path d="M11 11l6 6"/><path d="M17 11v6h-6"/>
{%- elif name == 'crop' -%}
  <path d="M6 2v14a2 2 0 0 0 2 2h14"/><path d="M18 22V8a2 2 0 0 0-2-2H2"/>
{%- elif name == 'rotate-cw' -%}
  <path d="M21 3v6h-6"/><path d="M21 9a9 9 0 1 0-3 6.7"/>
{%- elif name == 'sliders' -%}
  <path d="M4 6h10"/><path d="M18 6h2"/><circle cx="16" cy="6" r="2"/>
  <path d="M4 14h4"/><path d="M12 14h8"/><circle cx="10" cy="14" r="2"/>
  <path d="M4 20h10"/><path d="M18 20h2"/><circle cx="16" cy="20" r="2"/>
{%- elif name == 'file-image' -%}
  <path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5"/>
  <circle cx="10" cy="12" r="1.4"/><path d="M17 19l-4-4-6 4"/>
{%- elif name == 'maximize' -%}
  <path d="M9 3H5a2 2 0 0 0-2 2v4"/><path d="M15 3h4a2 2 0 0 1 2 2v4"/>
  <path d="M21 15v4a2 2 0 0 1-2 2h-4"/><path d="M3 15v4a2 2 0 0 0 2 2h4"/>
  <path d="M9 12h6"/><path d="M12 9v6"/>
{%- elif name == 'scissors' -%}
  <circle cx="6" cy="6" r="2.6"/><circle cx="6" cy="18" r="2.6"/>
  <path d="M20 4L8.6 15.4"/><path d="M14.5 14.5L20 20"/><path d="M8.6 8.6L12 12"/>
{%- elif name == 'stamp' -%}
  <path d="M5 21h14"/><path d="M7 17h10v-2a3 3 0 0 0-3-3h-4a3 3 0 0 0-3 3z"/>
  <path d="M10 12V7a2 2 0 1 1 4 0v5"/>
{%- elif name == 'user-x' -%}
  <path d="M14 20v-1a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v1"/><circle cx="8" cy="7" r="3.4"/>
  <path d="M17 6l5 5"/><path d="M22 6l-5 5"/>
{%- elif name == 'message-square' -%}
  <path d="M20 14a2 2 0 0 1-2 2H8l-4 4V5a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2z"/>
  <path d="M8 8h8"/><path d="M8 11h5"/>
{%- elif name == 'lock' -%}
  <rect x="4" y="10" width="16" height="11" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/>
{%- elif name == 'eye-off' -%}
  <path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6-10-6-10-6z"/><circle cx="12" cy="12" r="3"/>
  <path d="M3 3l18 18"/>
{%- elif name == 'merge' -%}
  <path d="M7 3v6a4 4 0 0 0 4 4h8"/><path d="M16 9l3 4-3 4"/><path d="M7 21v-6"/>
{%- elif name == 'split' -%}
  <path d="M17 3h4v4"/><path d="M21 3l-7 7"/><path d="M17 21h4v-4"/><path d="M21 21l-7-7"/>
  <path d="M3 12h8"/>
{%- elif name == 'code' -%}
  <path d="M9 17l-5-5 5-5"/><path d="M15 7l5 5-5 5"/>
{%- elif name == 'file-text' -%}
  <path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5"/>
  <path d="M8 13h8"/><path d="M8 17h5"/>
{%- elif name == 'table' -%}
  <rect x="3" y="4" width="18" height="16" rx="2"/>
  <path d="M3 10h18"/><path d="M3 15h18"/><path d="M9 10v10"/><path d="M15 10v10"/>
{%- elif name == 'presentation' -%}
  <path d="M3 4h18"/><path d="M4 4v10a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V4"/>
  <path d="M9 12V9"/><path d="M13 12V7"/><path d="M12 16v4"/><path d="M9 20h6"/>
{%- elif name == 'scan-text' -%}
  <path d="M4 8V6a2 2 0 0 1 2-2h2"/><path d="M16 4h2a2 2 0 0 1 2 2v2"/>
  <path d="M20 16v2a2 2 0 0 1-2 2h-2"/><path d="M8 20H6a2 2 0 0 1-2-2v-2"/>
  <path d="M8 10h8"/><path d="M8 14h5"/>
{%- elif name == 'redact' -%}
  {# The blacked-out bar is the one thing everyone recognises redaction by, so
     it is drawn filled rather than outlined like the rest of the set. #}
  <path d="M5 6.5h11"/><path d="M5 18h8"/>
  <rect x="4.5" y="10" width="15" height="4.5" rx="0.75" fill="currentColor" stroke="none"/>
{%- elif name == 'pen-line' -%}
  <path d="M4 21h16"/><path d="M14.5 4.5a2.12 2.12 0 0 1 3 3L8 17l-4 1 1-4z"/>
{%- elif name == 'compare' -%}
  <rect x="3" y="4" width="7" height="16" rx="1.5"/><rect x="14" y="4" width="7" height="16" rx="1.5"/>
  <path d="M5.5 9h2"/><path d="M5.5 12.5h3"/><path d="M16.5 9h3"/><path d="M16.5 12.5h2"/>
{%- elif name == 'summary' -%}
  {# Text narrowing as it goes down: the shape of the operation. #}
  <path d="M4 5h16"/><path d="M4 9h16"/><path d="M4 13h16"/><path d="M7 17h10"/><path d="M9 21h6"/>
{%- else -%}
  <circle cx="12" cy="12" r="9"/>
{%- endif -%}
</svg>
{% endmacro %}
