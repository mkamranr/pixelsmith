{% import "_icons.njk" as ic %}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% block title %}Pixelsmith{% endblock %}</title>
<meta name="description" content="Pixelsmith — a self-hosted image and PDF workshop. Your files never leave the building.">
<link rel="stylesheet" href="/static/styles.css">
<link rel="icon" href="/static/brand/favicon-32.png" sizes="32x32" type="image/png">
<link rel="icon" href="/static/brand/favicon-16.png" sizes="16x16" type="image/png">
<link rel="apple-touch-icon" href="/static/brand/apple-touch-icon.png">
</head>
<body>
<a class="skip" href="#main">Skip to content</a>

<header class="topbar">
  <div class="wrap topbar-inner">
    <a class="brand" href="/">
      {#
        The mark is the artwork; the name stays as text so it takes the theme
        colour, scales with the type and reads properly aloud. alt is empty
        because the word beside it already says what this is.
      #}
      <img class="brand-mark" src="/static/brand/mark.png" alt="" width="34" height="28" decoding="async">
      <span class="brand-name">Pixelsmith</span>
    </a>

    <nav class="nav" aria-label="Main">
      {# A disclosure rather than a scripted dropdown: it opens, closes and is
         keyboard operable with no JavaScript at all. Script only adds
         outside-click and Escape. #}
      {% for family in families %}
      <details class="menu" data-menu>
        <summary class="menu-trigger">
          {{ family.label }}
          <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor"
               stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M6 9l6 6 6-6"/></svg>
        </summary>

        <div class="menu-panel" role="group" aria-label="{{ family.label }} tools">
          <div class="menu-inner">
          {% for group in family.groups %}
            <section class="menu-group">
              <h2 class="menu-group-title">{{ group.label }}</h2>
              <ul class="menu-list">
                {% for tool in group.tools %}
                  <li>
                    <a href="/tools/{{ tool.id }}">
                      <span class="menu-icon">{{ ic.icon(tool.ui.icon, 16) }}</span>
                      <span class="menu-name">{{ tool.title }}</span>
                    </a>
                  </li>
                {% endfor %}
              </ul>
            </section>
          {% endfor %}
          </div>
        </div>
      </details>
      {% endfor %}

      {% if openAccess %}
        <a href="/jobs">My jobs</a>
        <a href="/api/docs">API</a>
      {% elif user %}
        <a href="/jobs">My jobs</a>
        {% if isAdmin %}<a href="/admin/users">Users</a>{% endif %}
        <a href="/api/docs">API</a>
        <a href="/account" class="nav-user">{{ user.name }}</a>
        <form method="post" action="/logout" class="inline-form">
          <input type="hidden" name="_csrf" value="{{ csrfToken }}">
          <button class="btn btn-quiet" type="submit">Sign out</button>
        </form>
      {% else %}
        <a href="/api/docs">API</a>
        <a class="btn btn-primary" href="/login">Sign in</a>
      {% endif %}
    </nav>
  </div>
</header>

<main id="main" class="wrap {% block mainClass %}{% endblock %}">
  {% block content %}{% endblock %}
</main>

<footer class="footer">
  <div class="wrap footer-inner">
    <p><strong>Pixelsmith</strong> — self-hosted image and PDF workshop. Nothing is uploaded anywhere but this server.</p>
    <p class="muted">Results are deleted automatically after {{ retentionHours }} hour{% if retentionHours != 1 %}s{% endif %}.</p>
  </div>
</footer>

<script src="/static/app.js" defer></script>
{% block scripts %}{% endblock %}
</body>
</html>
