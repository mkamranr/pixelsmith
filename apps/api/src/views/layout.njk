<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% block title %}Pixelsmith{% endblock %}</title>
<meta name="description" content="Pixelsmith — a self-hosted image workshop. Your images never leave the building.">
<link rel="stylesheet" href="/static/styles.css">
<link rel="icon" href="/static/favicon.svg" type="image/svg+xml">
</head>
<body>
<a class="skip" href="#main">Skip to content</a>

<header class="topbar">
  <div class="wrap topbar-inner">
    <a class="brand" href="/">
      <svg class="brand-mark" viewBox="0 0 32 32" aria-hidden="true" focusable="false">
        <path d="M6 21 L14 13 L19 18 L26 11" fill="none" stroke="currentColor" stroke-width="2.5"
              stroke-linecap="round" stroke-linejoin="round"/>
        <circle cx="10" cy="9" r="2.5" fill="currentColor"/>
      </svg>
      <span class="brand-name">Pixelsmith</span>
    </a>

    <nav class="nav" aria-label="Main">
      {% if user %}
        <a href="/jobs">My jobs</a>
        {% if isAdmin %}<a href="/admin/users">Users</a>{% endif %}
        <a href="/api/docs">API</a>
        <a href="/account" class="nav-user">{{ user.name }}</a>
        <form method="post" action="/logout" class="inline-form">
          <input type="hidden" name="_csrf" value="{{ csrfToken }}">
          <button class="btn btn-quiet" type="submit">Sign out</button>
        </form>
      {% else %}
        <a href="/api/docs">API</a>
        <a class="btn btn-primary" href="/login">Sign in</a>
      {% endif %}
    </nav>
  </div>
</header>

<main id="main" class="wrap">
  {% block content %}{% endblock %}
</main>

<footer class="footer">
  <div class="wrap footer-inner">
    <p><strong>Pixelsmith</strong> — self-hosted image workshop. Nothing is uploaded anywhere but this server.</p>
    <p class="muted">Results are deleted automatically after {{ retentionHours }} hour{% if retentionHours != 1 %}s{% endif %}.</p>
  </div>
</footer>

<script src="/static/app.js" defer></script>
</body>
</html>
