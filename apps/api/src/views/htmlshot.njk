{% extends "layout.njk" %}
{% import "_macros.njk" as m %}
{% import "_icons.njk" as ic %}
{% block title %}{{ tool.title }} — Pixelsmith{% endblock %}
{% block mainClass %}wrap-wide{% endblock %}
{% block content %}

<nav class="crumbs"><a href="/">Tools</a> <span aria-hidden="true">/</span> {{ tool.title }}</nav>

{% if error %}<div class="alert alert-error" role="alert">{{ error }}</div>{% endif %}

{% if not canUse %}
  <h1 class="page-title">{{ tool.title }}</h1>
  <div class="alert">You need to <a href="/login?next=/tools/{{ tool.id }}">sign in</a> to use this.</div>
{% else %}

<h1 class="page-title">{{ tool.title }}</h1>
{% if tool.ui.blurb %}<p class="lede">{{ tool.ui.blurb }}</p>{% endif %}

<form class="workspace" method="post" action="/tools/{{ tool.id }}" data-htmlshot>
  <input type="hidden" name="_csrf" value="{{ csrfToken }}">

  <section class="stage shot-stage">
    <div class="shot-empty" data-shot-empty>
      <span class="shot-icon">{{ ic.icon('code', 40) }}</span>
      <h2>Nothing rendered yet</h2>
      <p class="muted">
        Put a web address in the panel and press <strong>Preview</strong> to see how it will come out,
        or switch to pasted HTML.
      </p>
    </div>

    <div class="shot-result" data-shot-result hidden>
      <div class="shot-toolbar">
        <span class="shot-meta" data-shot-meta></span>
        <button type="button" class="btn btn-sm" data-shot-refresh>Refresh preview</button>
      </div>
      <div class="shot-frame">
        <img data-shot-image alt="Preview of the rendered page">
      </div>
    </div>

    <div class="shot-busy" data-shot-busy hidden>
      <span class="spinner" aria-hidden="true"></span>
      <p>Rendering…</p>
      <p class="hint">A headless browser is loading the page. This can take a few seconds.</p>
    </div>

    <div class="alert alert-error" data-shot-error hidden role="alert"></div>
  </section>

  <aside class="panel">
    <div class="panel-head">
      <h2 class="panel-title"><span class="panel-icon">{{ ic.icon('code', 18) }}</span>Settings</h2>
    </div>

    {# The source switch first: it decides which of the two inputs below applies. #}
    {% for f in tool.ui.fields %}{% if f.name == 'source' %}{{ m.field(f) }}{% endif %}{% endfor %}

    <div class="field" data-field="url" data-show-when-field="source" data-show-when-equals="url">
      <label for="f-url">Website URL</label>
      <div class="url-row">
        <input type="url" id="f-url" name="url" placeholder="https://intranet.example/page" autocomplete="url">
        <button type="button" class="btn url-go" data-shot-refresh title="Render a preview">
          {{ ic.icon('rotate-cw', 16) }}
        </button>
      </div>
      <p class="hint">
        {% if allowedRenderHosts | length %}
          Permitted hosts: <code>{{ allowedRenderHosts | join(', ') }}</code>
        {% else %}
          No hosts are allowlisted on this server, so URL rendering is refused. An administrator
          sets <code>ALLOWED_RENDER_HOSTS</code> to enable it.
        {% endif %}
      </p>
    </div>

    <div class="panel-fields">
      {% for f in tool.ui.fields %}
        {% if f.name != 'source' and f.name != 'url' %}{{ m.field(f) }}{% endif %}
      {% endfor %}
    </div>

    <div class="panel-footer">
      <button type="button" class="btn btn-block" data-shot-refresh>Preview</button>
      <button class="btn btn-primary btn-block btn-lg" type="submit" style="margin-top:8px">
        Convert HTML
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"
             stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M5 12h14"/><path d="M13 6l6 6-6 6"/></svg>
      </button>
      <p class="hint">Preview is quick and not kept. Convert creates a job you can download.</p>
    </div>
  </aside>
</form>

<script src="{{ asset('/static/htmlshot.js') }}" defer></script>
{% endif %}
{% endblock %}
