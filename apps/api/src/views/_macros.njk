{# Renders one declarative tool field. The tool declares these once and both
   this form and the API docs read from that same declaration. #}
{% macro field(f) %}
<div class="field{% if f.kind == 'toggle' %} field-toggle{% endif %}" data-field="{{ f.name }}"
     {% if f.showWhen %}data-show-when-field="{{ f.showWhen.field }}"
     data-show-when-equals="{{ f.showWhen.equals | join(',') }}"{% endif %}>
  {% if f.kind != 'toggle' %}<label for="f-{{ f.name }}">{{ f.label }}</label>{% endif %}

  {% if f.kind == 'select' %}
    <select id="f-{{ f.name }}" name="{{ f.name }}">
      {% for opt in f.options %}
        <option value="{{ opt.value }}" {% if opt.value == f.default %}selected{% endif %}>{{ opt.label }}</option>
      {% endfor %}
    </select>

  {% elif f.kind == 'segmented' %}
    {# Radios, not buttons: the choice submits and is keyboard-navigable with
       no script involved. #}
    <div class="segmented" role="radiogroup" aria-label="{{ f.label }}">
      {% for opt in f.options %}
        <label class="segment">
          <input type="radio" name="{{ f.name }}" value="{{ opt.value }}"
                 {% if opt.value == f.default %}checked{% endif %}>
          <span>{{ opt.label }}</span>
        </label>
      {% endfor %}
    </div>

  {% elif f.kind == 'toggle' %}
    {# The whole row is the label, so the text is part of the hit target. #}
    <label class="check-row" for="f-{{ f.name }}">
      <input type="checkbox" id="f-{{ f.name }}" name="{{ f.name }}" value="true"
             {% if f.default %}checked{% endif %}>
      <span>{{ f.label }}</span>
    </label>
    {% if f.help %}<p class="hint hint-indent">{{ f.help }}</p>{% endif %}

  {% elif f.kind == 'textarea' %}
    <textarea id="f-{{ f.name }}" name="{{ f.name }}" rows="10" spellcheck="false"
              placeholder="&lt;h1&gt;Hello&lt;/h1&gt;">{% if f.default %}{{ f.default }}{% endif %}</textarea>

  {% elif f.kind == 'number' or f.kind == 'range' %}
    <input type="number" id="f-{{ f.name }}" name="{{ f.name }}"
           {% if f.min is defined %}min="{{ f.min }}"{% endif %}
           {% if f.max is defined %}max="{{ f.max }}"{% endif %}
           {% if f.default is defined %}value="{{ f.default }}"{% endif %}
           placeholder="auto">

  {% elif f.kind == 'color' %}
    <input type="color" id="f-{{ f.name }}" name="{{ f.name }}" value="{{ f.default or '#ffffff' }}">

  {% else %}
    <input type="text" id="f-{{ f.name }}" name="{{ f.name }}"
           {% if f.default is defined %}value="{{ f.default }}"{% endif %}>
  {% endif %}

  {% if f.help and f.kind != 'toggle' %}<p class="hint">{{ f.help }}</p>{% endif %}
</div>
{% endmacro %}

{% macro bytes(n) %}
{%- if n < 1024 -%}{{ n }} B
{%- elif n < 1048576 -%}{{ (n / 1024) | round(1) }} KB
{%- else -%}{{ (n / 1048576) | round(2) }} MB
{%- endif -%}
{% endmacro %}

{% macro statusPill(status) %}
<span class="pill pill-{{ status }}">{{ status }}</span>
{% endmacro %}

{# Results carried forward from a previous job. Rendered server-side, so the
   files are visible and named before any script runs. #}
{% macro carried(sourceJob, sourceFiles) %}
{% if sourceFiles and sourceFiles | length %}
<div class="carried">
  <input type="hidden" name="fromJob" value="{{ sourceJob.id }}">
  <div class="carried-head">
    <span class="carried-badge">Carried over</span>
    <span class="muted">
      {{ sourceFiles | length }} result{% if sourceFiles | length != 1 %}s{% endif %}
      from your {{ sourceJob.toolId }} job — no need to upload again.
    </span>
  </div>
  <ul class="carried-list">
    {% for f in sourceFiles %}
      <li>
        <img src="/jobs/{{ sourceJob.id }}/files/{{ f.id }}" alt="{{ f.name }}" loading="lazy">
        <span class="carried-name">{{ f.name }}</span>
      </li>
    {% endfor %}
  </ul>
</div>
{% endif %}
{% endmacro %}
