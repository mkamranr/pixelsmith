{% extends "layout.njk" %}
{% import "_icons.njk" as ic %}
{% block title %}Pixelsmith — self-hosted image and PDF workshop{% endblock %}
{% block content %}

<section class="hero">
  <img class="hero-mark" src="{{ asset('/static/brand/mark.png') }}" alt="Pixelsmith"
       width="176" height="144" decoding="async">
  <p class="eyebrow">Runs entirely on your own server</p>
  <h1>Every image and PDF tool,<br><span class="accent">without the internet.</span></h1>
  <p class="lede">
    Compress, resize, convert, watermark and redact images. Merge, split, reorder and rotate PDFs.
    No third-party services, no API keys, no telemetry. Files are processed on this machine and
    deleted {{ retentionHours }} hour{% if retentionHours != 1 %}s{% endif %} later.
  </p>
  {% if not canUse %}
    <p class="hero-actions"><a class="btn btn-primary btn-lg" href="/login">Sign in to get started</a></p>
  {% elif openAccess %}
    {# Nothing to sign into: send people straight at the work. #}
    <p class="hero-actions">
      <a class="btn btn-primary btn-lg" href="/tools/compress">Compress images</a>
      <a class="btn btn-lg" href="/tools/resize">Resize images</a>
    </p>
  {% endif %}
</section>

{% for family in families %}
<section class="family">
  <h2 class="family-title">{{ family.label }}</h2>
  {% for group in family.groups %}
  <section class="group">
    <div class="group-head">
      <h3>{{ group.label }}</h3>
      <p class="muted">{{ group.blurb }}</p>
    </div>
    <ul class="tool-grid">
      {% for tool in group.tools %}
        <li>
          <a class="tool-card" href="/tools/{{ tool.id }}">
            <span class="tool-icon">{{ ic.icon(tool.ui.icon, 20) }}</span>
            <span class="tool-title">{{ tool.title }}</span>
            {% if tool.ui.blurb %}<span class="tool-blurb">{{ tool.ui.blurb }}</span>{% endif %}
          </a>
        </li>
      {% endfor %}
    </ul>
  </section>
  {% endfor %}
</section>
{% endfor %}

<section class="assurances">
  <div class="assurance">
    <h3>Air-gapped by design</h3>
    <p>No outbound connections. Fonts, styles and scripts are all served from this host.</p>
  </div>
  <div class="assurance">
    <h3>Nothing kept</h3>
    <p>Uploads and results are deleted on a timer, and orphaned files are swept up too.</p>
  </div>
  <div class="assurance">
    <h3>Metadata stripped</h3>
    <p>EXIF, GPS coordinates and camera details are removed from every processed image.</p>
  </div>
  <div class="assurance">
    <h3>Documents too</h3>
    <p>PDFs are merged, split, reordered and rotated by the same pipeline, on the same machine.</p>
  </div>
</section>
{% endblock %}
