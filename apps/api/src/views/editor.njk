{% extends "layout.njk" %}
{% import "_icons.njk" as ic %}
{% import "_macros.njk" as m %}
{% block title %}{{ tool.title }} — Pixelsmith{% endblock %}
{% block content %}

<nav class="crumbs"><a href="/">Tools</a> <span aria-hidden="true">/</span> {{ tool.title }}</nav>

{% if error %}<div class="alert alert-error" role="alert">{{ error }}</div>{% endif %}

{% if not user %}
  <h1 class="page-title">{{ tool.title }}</h1>
  <div class="alert">You need to <a href="/login?next=/tools/{{ tool.id }}">sign in</a> before editing images.</div>
{% else %}

<form class="workspace" method="post" action="/tools/{{ tool.id }}" enctype="multipart/form-data" data-editor>
  <input type="hidden" name="_csrf" value="{{ csrfToken }}">
  {# The recipe is what the server replays at full resolution. #}
  <input type="hidden" name="recipe" value='{"version":1,"ops":[]}' data-recipe>

  <section class="stage editor-stage" data-stage>
    {{ m.carried(sourceJob, sourceFiles) }}
    <div class="stage-head" data-stage-head hidden>
      <div class="stage-count"><strong data-file-count>0</strong> <span data-file-noun>files</span></div>
      <div class="stage-actions">
        <button type="button" class="btn btn-sm" data-add-more>Change image</button>
        <button type="button" class="btn btn-sm" data-reset>Reset all</button>
      </div>
    </div>

    <div class="dropzone" data-dropzone>
      <input type="file" id="files" name="files" multiple accept="image/*" data-file-input
             {% if not sourceFiles or not sourceFiles | length %}required{% endif %}>
      <label for="files" class="dropzone-label">
        <span class="dropzone-icon" aria-hidden="true">{{ ic.icon('sliders', 34) }}</span>
        <strong>Choose an image to edit</strong>
        <span class="muted">Edits preview here and are applied at full resolution on the server</span>
      </label>
    </div>

    <div class="editor-canvas" data-canvas hidden>
      <div class="editor-frame" data-frame>
        <img data-preview alt="Edit preview">
        <div class="crop-box" data-crop-box hidden><span class="crop-label" data-crop-label></span></div>
      </div>
      <p class="stage-hint" data-editor-hint>Drag on the image to select a crop area.</p>
    </div>
  </section>

  <aside class="panel editor-panel">
    <div class="panel-head">
      <h1><span class="panel-icon">{{ ic.icon('sliders', 20) }}</span>{{ tool.title }}</h1>
      <p class="muted">{{ tool.ui.blurb }}</p>
    </div>

    <div class="panel-group">
      <span class="panel-label">Orientation</span>
      <div class="quick-row">
        <button type="button" class="btn quick-btn" data-op="rotate" data-value="-90">
          {{ ic.icon('rotate-cw', 16) }} Left
        </button>
        <button type="button" class="btn quick-btn" data-op="rotate" data-value="90">
          {{ ic.icon('rotate-cw', 16) }} Right
        </button>
        <button type="button" class="btn quick-btn" data-op="flop">Mirror ↔</button>
        <button type="button" class="btn quick-btn" data-op="flip">Mirror ↕</button>
      </div>
    </div>

    <div class="panel-group">
      <span class="panel-label">Adjust</span>
      <div class="slider-row">
        <label for="ed-brightness">Brightness</label>
        <input type="range" id="ed-brightness" data-adjust="brightness" min="0.2" max="2" step="0.05" value="1">
        <output data-out="brightness">1.00</output>
      </div>
      <div class="slider-row">
        <label for="ed-contrast">Contrast</label>
        <input type="range" id="ed-contrast" data-adjust="contrast" min="0.2" max="2" step="0.05" value="1">
        <output data-out="contrast">1.00</output>
      </div>
      <div class="slider-row">
        <label for="ed-saturation">Saturation</label>
        <input type="range" id="ed-saturation" data-adjust="saturation" min="0" max="2.5" step="0.05" value="1">
        <output data-out="saturation">1.00</output>
      </div>
      <div class="slider-row">
        <label for="ed-blur">Blur</label>
        <input type="range" id="ed-blur" data-adjust="blur" min="0" max="12" step="0.5" value="0">
        <output data-out="blur">0.0</output>
      </div>
      <div class="slider-row">
        <label for="ed-sharpen">Sharpen</label>
        <input type="range" id="ed-sharpen" data-adjust="sharpen" min="0" max="6" step="0.5" value="0">
        <output data-out="sharpen">0.0</output>
      </div>
      <label class="check-row">
        <input type="checkbox" data-adjust="greyscale"> Black and white
      </label>
    </div>

    <div class="panel-group">
      <span class="panel-label">Caption</span>
      <div class="field">
        <input type="text" data-text-input placeholder="Text to draw on the image" maxlength="300">
      </div>
      <div class="slider-row">
        <label for="ed-textsize">Size</label>
        <input type="range" id="ed-textsize" data-text-size min="0.03" max="0.4" step="0.01" value="0.12">
        <output data-out="textSize">0.12</output>
      </div>
      <div class="slider-row">
        <label for="ed-textcolor">Colour</label>
        <input type="color" id="ed-textcolor" data-text-color value="#ffffff">
      </div>
    </div>

    <div class="panel-group">
      <span class="panel-label">Output</span>
      <div class="field">
        <label for="ed-format">Format</label>
        <select id="ed-format" name="format">
          <option value="keep">Keep original</option>
          <option value="jpeg">JPEG</option>
          <option value="png">PNG</option>
          <option value="webp">WebP</option>
        </select>
      </div>
    </div>

    <div class="panel-footer">
      <button class="btn btn-primary btn-block btn-lg" type="submit">
        Apply &amp; save
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"
             stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M5 12h14"/><path d="M13 6l6 6-6 6"/></svg>
      </button>
      <p class="hint" data-op-summary>No changes yet.</p>
    </div>
  </aside>
</form>

<script src="/static/editor.js" defer></script>
{% endif %}
{% endblock %}
