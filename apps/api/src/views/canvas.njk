{% extends "layout.njk" %}
{% import "_macros.njk" as m %}
{% import "_icons.njk" as ic %}
{% block title %}{{ tool.title }} — Pixelsmith{% endblock %}
{% block mainClass %}wrap-wide{% endblock %}
{% block content %}

<nav class="crumbs"><a href="/">Tools</a> <span aria-hidden="true">/</span> {{ tool.title }}</nav>

{% if error %}<div class="alert alert-error" role="alert">{{ error }}</div>{% endif %}

{% if not canUse %}
  <h1 class="page-title">{{ tool.title }}</h1>
  <div class="alert">You need to <a href="/login?next=/tools/{{ tool.id }}">sign in</a> before processing images.</div>
{% else %}

<h1 class="page-title">{{ tool.title }}</h1>
{% if tool.ui.blurb %}<p class="lede">{{ tool.ui.blurb }}</p>{% endif %}

<form class="workspace" method="post" action="/tools/{{ tool.id }}" enctype="multipart/form-data"
      data-canvas-form data-preview="{{ tool.ui.preview or 'none' }}">
  <input type="hidden" name="_csrf" value="{{ csrfToken }}">

  <section class="stage canvas-stage" data-stage>
    {{ m.carried(sourceJob, sourceFiles) }}

    {% if not tool.pdfFileView %}
    {# Navigation across the batch. Hidden until there is more than one file. #}
    <div class="canvas-nav" data-nav hidden>
      <button type="button" class="nav-step" data-step="-1" aria-label="Previous image">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2"
             stroke-linecap="round" stroke-linejoin="round"><path d="M18 15l-6-6-6 6"/></svg>
      </button>
      <button type="button" class="nav-step" data-step="1" aria-label="Next image">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2"
             stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg>
      </button>
      <select class="nav-select" data-nav-select aria-label="Choose an image"></select>
    </div>
    {% endif %}

    {# Add-more control, with the count of what is loaded. #}
    <button type="button" class="canvas-add" data-add-more hidden aria-label="Add more images">
      <span class="canvas-add-count" data-file-count>0</span>
      <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="2.2"
           stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14"/><path d="M5 12h14"/></svg>
    </button>

    <div class="dropzone" data-dropzone>
      <input type="file" id="files" name="files" multiple accept="{{ tool.acceptAttribute }}" data-file-input
             {% if not sourceFiles or not sourceFiles | length %}required{% endif %}>
      <label for="files" class="dropzone-label">
        <span class="dropzone-icon" aria-hidden="true">{{ ic.icon(tool.ui.icon, 38) }}</span>
        <strong>{% if tool.family == 'pdf' %}Choose files{% else %}Choose images{% endif %}</strong>
        <span class="muted">or drag and drop them here</span>
        <span class="dropzone-meta">Takes {{ tool.acceptsDescription }} · up to {{ maxFiles }} files · {{ maxUploadMb }} MB each</span>
      </label>
    </div>

    {% if tool.pdfFileView %}
    {#
      A card per document: its first page, its weight, and controls to turn,
      drop or reorder it. What matters when merging is which document comes
      first, so the pages of any one of them are beside the point here.
    #}
    <section class="pdf-files" data-pdf-files hidden
             data-pdfjs="/static/vendor/pdfjs/pdf.min.mjs"
             data-pdfjs-worker="/static/vendor/pdfjs/pdf.worker.min.mjs"
             data-pdfjs-fonts="/static/vendor/pdfjs/standard_fonts/"
             data-pdfjs-cmaps="/static/vendor/pdfjs/cmaps/">
      <div class="pdf-pages-head">
        <h2 class="pdf-pages-title">Documents</h2>
        <p class="pdf-pages-hint" data-pdf-hint></p>
        <div class="pdf-pages-actions">
          <button type="button" class="btn btn-quiet btn-sm" data-sort-az>Sort A–Z</button>
        </div>
      </div>
      <ol class="pdf-file-grid" data-pdf-file-grid></ol>
    </section>
    {% elif tool.family == 'pdf' %}
    {#
      Page thumbnails, rendered in the browser by pdf.js. A PDF has no single
      image to show, and every tool here that takes a page range is far easier
      to use when you can see the pages you are choosing between.
    #}
    <section class="pdf-pages" data-pdf-pages hidden
             data-pdfjs="/static/vendor/pdfjs/pdf.min.mjs"
             data-pdfjs-worker="/static/vendor/pdfjs/pdf.worker.min.mjs"
             data-pdfjs-fonts="/static/vendor/pdfjs/standard_fonts/"
             data-pdfjs-cmaps="/static/vendor/pdfjs/cmaps/">
      <div class="pdf-pages-head">
        <h2 class="pdf-pages-title">Pages</h2>
        <p class="pdf-pages-hint" data-pdf-hint></p>
        <div class="pdf-pages-actions" data-pdf-actions hidden>
          <button type="button" class="btn btn-quiet btn-sm" data-pdf-all>Select all</button>
          <button type="button" class="btn btn-quiet btn-sm" data-pdf-none>Clear</button>
        </div>
      </div>
      <ol class="pdf-grid" data-pdf-grid></ol>
    </section>
    {% endif %}

    {% if not tool.pdfFileView %}
    <div class="canvas-view{% if tool.family == 'pdf' %} is-document{% endif %}" data-view hidden>
      {# The plate is hidden for documents: an <img> pointing at a PDF renders
         as a broken image, and the page grid above is the real preview. #}
      <div class="canvas-plate" data-plate>
        <img data-canvas-image alt="Preview">
        {# Overlays for the live preview are inserted here by script. #}
        {% if tool.imageBoxes %}
          {# The areas are drawn against the rendered image, so this layer sits
             exactly over it and shares its box. #}
          <div class="box-layer" data-image-boxes data-boxes-field="regions"></div>
        {% endif %}
      </div>
      {% if tool.imageBoxes %}
      <div class="box-bar" data-box-bar>
        <p class="box-hint" data-box-hint>Drag on the picture to mark an area. Drag it to move, its
          edges to resize, and press Delete to remove it.</p>
        <div class="box-bar-actions">
          <span class="box-count" data-box-count></span>
          <button type="button" class="btn btn-quiet btn-sm" data-box-clear hidden>Clear this photo</button>
        </div>
      </div>
      {% endif %}
      <div class="canvas-caption">
        <span class="canvas-name" data-canvas-name></span>
        <span class="thumb-sizes" data-canvas-sizes></span>
      </div>
      <button type="button" class="canvas-remove" data-remove-current hidden>Remove this {% if tool.family == 'pdf' %}file{% else %}image{% endif %}</button>
    </div>
    {% endif %}
  </section>

  <aside class="panel">
    <div class="panel-head">
      <h2 class="panel-title"><span class="panel-icon">{{ ic.icon(tool.ui.icon, 18) }}</span>Settings</h2>
    </div>

    {% block panelExtras %}{% endblock %}

    {% if tool.ui.fields | length %}
      {% if tool.ui.builder == 'form' %}
    {# The boxes belong to the document: they are read out of the uploaded file
       and offered here. The hidden field below is what gets posted. #}
    <div class="form-fill" data-form-fill hidden
         data-pdfjs="{{ asset('/static/vendor/pdfjs/pdf.min.mjs') }}"
         data-pdfjs-worker="{{ asset('/static/vendor/pdfjs/pdf.worker.min.mjs') }}"
         data-pdfjs-fonts="/static/vendor/pdfjs/standard_fonts/"
         data-pdfjs-cmaps="/static/vendor/pdfjs/cmaps/">
      <p class="panel-label">The form's own boxes</p>
      <div class="form-fields" data-form-fields></div>
      <p class="hint" data-form-status></p>
    </div>
    {% endif %}

    <div class="panel-fields">
        {% for f in tool.ui.fields %}{{ m.field(f) }}{% endfor %}
      </div>
    {% endif %}

    {% if tool.hasRangeField %}
      {# Rows of from/to, which write into the ranges field above. The field
         stays usable on its own if this never gets wired up. #}
      <div class="range-rows" data-range-rows hidden></div>
    {% endif %}

    <div class="panel-footer">
      <button class="btn btn-primary btn-block btn-lg" type="submit">
        {{ tool.title }}
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"
             stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M5 12h14"/><path d="M13 6l6 6-6 6"/></svg>
      </button>
      <p class="hint" data-summary></p>
    </div>
  </aside>
</form>

{% if tool.pdfFileView %}
<script src="{{ asset('/static/pdffiles.js') }}" defer></script>
{% else %}
<script src="{{ asset('/static/canvas.js') }}" defer></script>
{% if tool.imageBoxes %}<script src="{{ asset('/static/boxes.js') }}" defer></script>{% endif %}
{% if tool.ui.builder == 'form' %}<script src="{{ asset('/static/formfill.js') }}" type="module"></script>{% endif %}
{% if tool.family == 'pdf' %}<script src="{{ asset('/static/pdfpages.js') }}" defer></script>{% endif %}
{% if tool.hasRangeField %}<script src="{{ asset('/static/pdfranges.js') }}" defer></script>{% endif %}
{% endif %}
{% endif %}
{% endblock %}
