# Pixelsmith configuration. install.sh writes a filled-in copy of this as .env
# and generates the secret; edit afterwards to taste.

# ---- required ----
# Signs session cookies. Changing it signs everyone out.
COOKIE_SECRET=

# ---- where it listens ----
# 127.0.0.1 keeps it local so your own TLS proxy fronts it.
# Set 0.0.0.0 only if the host firewall is your boundary.
PUBLISH_ADDR=127.0.0.1
PUBLISH_PORT=8080
# Set true only when a reverse proxy in front sets X-Forwarded-For, otherwise
# clients can spoof their own IP in the audit log.
TRUST_PROXY=false

# ---- first administrator ----
# Used only on an empty database. Leave blank and the API prints a generated
# password to its log once, on first start.
# ---- Identity --------------------------------------------------------------
# open = anyone who can reach the page can use it, and no administrator is
# created. accounts = sign-in required; the first administrator is created on
# first boot and its password printed once to the log.
AUTH_MODE=open
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# ---- retention ----
# Hours before finished job files are deleted by the sweeper.
RETENTION_HOURS=2

# ---- limits ----
MAX_UPLOAD_BYTES=209715200
MAX_FILES_PER_JOB=30
JOB_TIMEOUT_MINUTES=15

# ---- capacity ----
# Runner replicas, and jobs each runs at once. Total parallel work is the
# product; keep it at or below the host's core count.
RUNNER_REPLICAS=2
RUNNER_CONCURRENCY=2
INFERENCE_THREADS=2

# ---- HTML to image ----
# Comma-separated hosts the renderer may fetch. EMPTY (the default) refuses all
# URL rendering and permits pasted HTML only. Add hosts only if you genuinely
# need to screenshot an internal page, and understand that the renderer will
# then reach them from inside your network.
ALLOWED_RENDER_HOSTS=

LOG_LEVEL=info
