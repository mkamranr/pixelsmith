# Copy to .env and edit. Every value here is the default, so an empty .env is a
# working configuration.

# ---- Where it listens ------------------------------------------------------
PUBLISH_PORT=8080
# Bind to localhost when a reverse proxy fronts the stack.
PUBLISH_ADDR=0.0.0.0
# Only true behind a proxy you control: it makes the app believe forwarded
# headers about who the client is.
TRUST_PROXY=false

# ---- Limits and retention --------------------------------------------------
MAX_UPLOAD_BYTES=209715200
MAX_FILES_PER_JOB=30
# How long results survive after a job finishes. The setting to think hardest
# about: it is the difference between the files being gone and being on a disk.
RETENTION_HOURS=2
JOB_TIMEOUT_MINUTES=15

# ---- Capacity --------------------------------------------------------------
RUNNER_REPLICAS=2
RUNNER_CONCURRENCY=2
INFERENCE_THREADS=2

# ---- Identity --------------------------------------------------------------
# open = anyone who can reach the page can use it, jobs scoped to a browser.
# accounts = sign-in required, every job attributed in the audit log.
AUTH_MODE=open
# Generated and stored on the data volume if left empty.
COOKIE_SECRET=
# First administrator, accounts mode only. Used once, at first boot.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# ---- The one outbound setting ---------------------------------------------
# Hosts the HTML-to-image and HTML-to-PDF tools may load. Comma separated.
# Empty means none, which is the default and the safe answer. Pasted markup
# needs no entry here.
ALLOWED_RENDER_HOSTS=

# ---- Logging ---------------------------------------------------------------
LOG_LEVEL=info
